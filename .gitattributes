# GitHub Linguist Language Override
*.js linguist-detectable=false
*.jsx linguist-detectable=false
*.css linguist-detectable=false
*.html linguist-detectable=false
*.json linguist-detectable=false

*.js linguist-vendored=true
*.jsx linguist-vendored=true
*.css linguist-vendored=true
*.html linguist-vendored=true

docs/** linguist-detectable=false
docs/** linguist-vendored=true
docs/** linguist-generated=true

frontend/** linguist-detectable=false
frontend/** linguist-vendored=true

*.py linguist-detectable=true
*.py linguist-vendored=false
