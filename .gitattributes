# Force GitHub Linguist to detect TypeScript Frontend & Python Backend
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
frontend/src/** linguist-detectable=true

# Ignore vendor/generated data files
frontend/node_modules/** linguist-vendored=true
frontend/dist/** linguist-vendored=true
frontend/package-lock.json linguist-generated=true
static/i18n.json linguist-generated=true
docs/** linguist-documentation=true
data/** linguist-vendored=true
